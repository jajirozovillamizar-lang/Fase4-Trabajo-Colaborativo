# SECCIÓN 2. CLASE ABSTRACTA BASE Y CLASE CLIENTE
# =====================================================================

class EntidadBase(abc.ABC):
    """Clase abstracta que representa cualquier entidad del sistema."""

    def __init__(self, identificador):
        if identificador is None or str(identificador).strip() == "":   # El identificador es obligatorio
            raise DatoVacioError("identificador")
        self._identificador = str(identificador).strip()                  # Atributo protegido

    @property
    def identificador(self):
        return self._identificador                                        # Solo lectura desde afuera

    @abc.abstractmethod
    def obtener_informacion(self):
        """Cada clase hija debe programar este método a su manera."""

    @abc.abstractmethod
    def validar(self):
        """Cada clase hija revisa que sus propios datos estén correctos."""


class Cliente(EntidadBase):
    """Cliente de Software FJ con sus datos personales encapsulados."""

    PATRON_CORREO = r"^[\w\.-]+@[\w-]+(\.[\w-]+)+$"     # Forma general de un correo: usuario@dominio.ext

    def __init__(self, cedula, nombre, correo):
        super().__init__(cedula)                       # La cédula es el identificador del cliente
        self.nombre = nombre                           # Pasa por el setter, que valida
        self.correo = correo                           # Pasa por el setter, que valida
        self.validar()                                 # Revisión final de la cédula

    @property
    def cedula(self):
        return self.identificador                      # La cédula se puede leer pero no cambiar

    @property
    def nombre(self):
        return self.__nombre                           # Lectura del atributo privado

    @nombre.setter
    def nombre(self, valor):
        if valor is None or str(valor).strip() == "":                  # No se permite nombre vacío
            raise DatoVacioError("nombre")
        valor = str(valor).strip()                                     # Quitamos espacios sobrantes
        if not all(c.isalpha() or c.isspace() for c in valor):         # Solo letras y espacios
            raise FormatoInvalidoError("nombre", valor)
        self.__nombre = valor                                          # Se guarda ya validado

    @property
    def correo(self):
        return self.__correo                           # Lectura del atributo privado

    @correo.setter
    def correo(self, valor):
        if valor is None or str(valor).strip() == "":                  # No se permite correo vacío
            raise DatoVacioError("correo")
        valor = str(valor).strip().lower()                             # Se guarda en minúscula
        if not re.match(self.PATRON_CORREO, valor):                    # Debe tener la forma de un correo
            raise FormatoInvalidoError("correo", valor)
        self.__correo = valor

    def validar(self):
        if not self.cedula.isdigit():                                  # La cédula solo lleva números
            raise FormatoInvalidoError("cédula", self.cedula)
        if not 6 <= len(self.cedula) <= 10:                            # Largo normal de una cédula en Colombia
            raise ValorFueraDeRangoError("dígitos de la cédula", len(self.cedula), 6, 10)
        return True

    def obtener_informacion(self):
        return f"Cliente: {self.nombre} | Cédula: {self.cedula} | Correo: {self.correo}"

# 3. Clase abstracta Servicio y al menos tres servicios especializados que hereden de ella

class Servicio(EntidadBase):
    def __init__(self, codigo, nombre_servicio, costo_base):
        super().__init__(codigo)  
        self.nombre_servicio = nombre_servicio
        self.costo_base = costo_base

    @abc.abstractmethod
    def calcular_costo(self):
        """Obliga a los hijos a programar su propio cálculo de costo"""
        pass

    @abc.abstractmethod
    def obtener_detalles(self):
        """Obliga a los hijos a programar su propia descripción"""
        pass

    # Solución técnica para que EntidadBase no falle al instanciar los servicios
    def obtener_informacion(self):
        return self.obtener_detalles()
