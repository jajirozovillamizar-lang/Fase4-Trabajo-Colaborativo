class ValorFueraDeRangoError(ValidacionError):
    def __init__(self, campo, valor, minimo, maximo):
        super().__init__(f"'{campo}' = {valor} está fuera del rango permitido ({minimo} a {maximo}).", "FJ-103")


class ParametroFaltanteError(ValidacionError):
