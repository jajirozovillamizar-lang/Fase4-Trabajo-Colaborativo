# Configuración del archivo donde quedan guardados todos los eventos y errores
logging.basicConfig(
    filename="software_fj.log",                              # Nombre del archivo de logs
    level=logging.INFO,                                      # Se guarda desde INFO hacia arriba
    format="%(asctime)s - %(levelname)s - %(message)s",      # Fecha, nivel y mensaje en cada línea
    encoding="utf-8",                                        # Para que las tildes se guarden bien
)


def registrar_evento(mensaje):
    """Guarda en el log una operación que salió bien."""
    logging.info(mensaje)                                    # Nivel INFO para eventos normales


def registrar_error(error):
    """Guarda en el log un error controlado, con su causa si viene encadenado."""
    texto = f"{type(error).__name__}: {error}"               # Nombre de la excepción y su mensaje
    if error.__cause__ is not None:                          # Si el error fue encadenado con 'from'
        texto += f" | Causa original: {type(error.__cause__).__name__}: {error.__cause__}"
    logging.error(texto)                                     # Nivel ERROR para fallos controlados


class SoftwareFJError(Exception):
    """Excepción base del sistema. Todas las demás heredan de esta."""

    def __init__(self, mensaje, codigo="FJ-000"):
        super().__init__(mensaje)                            # Guarda el mensaje como cualquier Exception
        self.codigo = codigo                                 # Código propio para identificar el error

    def __str__(self):
        return f"[{self.codigo}] {self.args[0]}"             # Muestra el código junto al mensaje


# --- Errores de validación de datos ---
